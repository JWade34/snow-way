namespace :guides do
  desc "Write db/guide_dates.yml (first and last commit date of each guide partial) so guides show real dates"
  task dates: :environment do
    dates = Guide.all.to_h do |g|
      file = "app/views/#{g.partial.sub(%r{/([^/]+)\z}, '/_\1')}.html.erb"
      log = `git log --follow --format=%as -- #{file}`.split
      [ g.slug, { "published" => log.last || Date.current.iso8601, "updated" => log.first || Date.current.iso8601 } ]
    end
    File.write(Rails.root.join("db/guide_dates.yml"), "# Generated by bin/rails guides:dates. Re-run after editing guides.\n" + dates.to_yaml)
    puts "Wrote #{dates.size} guide dates"
  end
end
