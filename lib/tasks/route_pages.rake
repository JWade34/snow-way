namespace :route_pages do
  desc "Write db/route_drives.yml: drive time and road miles from each origin (airport and downtown) to each route's resorts"
  task drives: :environment do
    require "net/http"
    out = { "source" => "OSRM routing on OpenStreetMap data (router.project-osrm.org), fetched #{Date.current}. Minutes are OSRM times x 0.8, calibrated against known routes. Typical time without traffic or snow.", "routes" => {} }
    RoutePage.all.each do |page|
      out["routes"][page.slug] = page.resorts.to_h do |resort|
        legs = { "airport" => page.origin["airport_coords"], "city" => page.origin["city_coords"] }.transform_values do |(lat, lon)|
          uri = URI("https://router.project-osrm.org/route/v1/driving/#{lon},#{lat};#{resort.longitude.to_f},#{resort.latitude.to_f}?overview=false")
          route = JSON.parse(Net::HTTP.get(uri)).dig("routes", 0)
          sleep 1
          route && { "minutes" => (route["duration"] * 0.8 / 60).round, "miles" => (route["distance"] / 1609.34).round }
        end
        [ resort.slug, legs ]
      end
      puts "#{page.slug}: #{out["routes"][page.slug].inspect}"
    end
    File.write(Rails.root.join("db/route_drives.yml"), "# Generated by bin/rails route_pages:drives\n" + out.to_yaml)
  end
end
