namespace :resorts do
  desc "Upsert resorts from db/resorts.yml and queue forecasts for any new ones"
  task sync: :environment do
    created = Resort.sync_from_data_file!
    puts "Resorts synced: #{Resort.count} total, #{created.size} new#{created.any? ? " (#{created.map(&:name).join(", ")})" : ""}"
    if SnowForecast.where(forecast_date: Date.current.., snowfall_summit_inches: nil).exists?
      RefreshSnowForecastsJob.perform_later # forecasts predate mid-mountain/summit split; refresh everything now
    elsif created.any?
      RefreshSnowForecastsJob.perform_later(created.map(&:id))
    end
    IndexNowJob.perform_later # runs on every deploy: submits any never-submitted URLs
  end
end

namespace :resorts do
  desc "Write db/powder_odds.yml: % of days with 1\"+ fresh snow per ski-season month, 10 seasons of Open-Meteo history"
  task powder_odds: :environment do
    require "net/http"
    file = Rails.root.join("db/powder_odds.yml")
    out = File.exist?(file) ? (YAML.load_file(file) || {}) : {}
    out["resorts"] ||= {}
    Resort.north_america.order(:name).each do |r|
      next if out["resorts"][r.slug] && ENV["FORCE"].blank?
      mid = ((r.elevation_base.to_i + r.elevation_summit.to_i) / 2.0 * 0.3048).round
      uri = URI("https://archive-api.open-meteo.com/v1/archive?" + {
        latitude: r.latitude.to_f, longitude: r.longitude.to_f, elevation: mid,
        start_date: "2015-07-01", end_date: "2025-06-30", daily: "snowfall_sum", timezone: "auto"
      }.to_query)
      body = nil
      3.times do |attempt|
        res = Net::HTTP.get_response(uri)
        if res.code == "200" then body = JSON.parse(res.body); break end
        puts "#{r.slug}: HTTP #{res.code}, retrying"; sleep 20 * (attempt + 1)
      end
      next puts("#{r.slug}: skipped") unless body
      days = body.dig("daily", "time").zip(body.dig("daily", "snowfall_sum"))
      by_month = days.group_by { |d, _| d[5, 2].to_i }
      odds = r.ski_season_months.to_h do |m|
        rows = by_month.fetch(m, []).reject { |_, v| v.nil? }
        [ m, rows.empty? ? 0 : (rows.count { |_, v| v >= 2.54 } * 100.0 / rows.size).round ]
      end
      out["resorts"][r.slug] = odds
      out["source"] = "Open-Meteo historical weather (ERA5-based), July 2015 to June 2025, mid-mountain elevation; a fresh-snow day is 1 inch or more of modeled snowfall"
      out["generated_on"] = Date.current.iso8601
      File.write(file, out.to_yaml)
      puts "#{r.slug}: #{odds.inspect}"
      sleep 1.5
    end
  end
end

namespace :resorts do
  desc "Write db/drive_times.yml: driving minutes from each city hub to its nearby resorts (OSRM, OpenStreetMap data)"
  task drive_times: :environment do
    require "net/http"
    out = { "source" => "OSRM routing on OpenStreetMap data (router.project-osrm.org), fetched #{Date.current}. Minutes are OSRM times x 0.8, calibrated against known routes (Boston-Loon, Denver-Keystone, Seattle-Snoqualmie, NYC-Mountain Creek). Typical time without traffic or snow.", "hubs" => {} }
    SkiHub.all.each do |hub|
      resorts = hub.nearby.map(&:first)
      coords = ([ [ hub.lon, hub.lat ] ] + resorts.map { |r| [ r.longitude.to_f, r.latitude.to_f ] }).map { |lon, lat| "#{lon.round(5)},#{lat.round(5)}" }.join(";")
      uri = URI("https://router.project-osrm.org/table/v1/driving/#{coords}?sources=0&annotations=duration,distance")
      data = JSON.parse(Net::HTTP.get(uri))
      next warn("#{hub.slug}: #{data["code"]}") unless data["code"] == "Ok"
      out["hubs"][hub.slug] = resorts.each_with_index.filter_map do |r, i|
        sec, meters = data["durations"][0][i + 1], data["distances"][0][i + 1]
        [ r.slug, { "minutes" => (sec * 0.8 / 60).round, "miles" => (meters / 1609.34).round } ] if sec && meters
      end.to_h
      puts "#{hub.slug}: #{out["hubs"][hub.slug].size}"
      sleep 1.5
    end
    File.write(Rails.root.join("db/drive_times.yml"), "# Generated by bin/rails resorts:drive_times\n" + out.to_yaml)
  end
end

namespace :resorts do
  desc "Write db/station_odds.yml: % of days with measured new snow per ski-season month at each resort's SNOTEL station (db/snow_stations.yml), 10 seasons"
  task station_odds: :environment do
    require "net/http"
    stations = YAML.load_file(Rails.root.join("db/snow_stations.yml"))
    out = { "source" => "USDA NRCS SNOTEL station measurements, July 2015 to June 2025. A new-snow day is one where the snow pillow's water reading rose 0.1 inch or more (about an inch of snow) on a day averaging 34°F or colder, so rain doesn't count.",
            "generated_on" => Date.current.iso8601, "resorts" => {} }
    stations["resorts"].each do |slug, st|
      r = Resort.find_by(slug: slug) or next puts("#{slug}: no resort")
      uri = URI("https://wcc.sc.egov.usda.gov/awdbRestApi/services/v1/data?" + { stationTriplets: st["triplet"], elements: "WTEQ,SNWD,TAVG",
        duration: "DAILY", beginDate: "2015-06-30", endDate: "2025-06-30" }.to_query)
      body = nil
      3.times do |attempt|
        res = Net::HTTP.get_response(uri)
        if res.code == "200" then body = JSON.parse(res.body); break end
        puts "#{slug}: HTTP #{res.code}, retrying"; sleep 10 * (attempt + 1)
      end
      next puts("#{slug}: skipped") unless body
      el = Array(body.first&.dig("data")).to_h { |e| [ e.dig("stationElement", "elementCode"), e["values"].to_h { |v| [ v["date"], v["value"] ] } ] }
      swe, temp = el.fetch("WTEQ", {}), el.fetch("TAVG", {})
      hits = Hash.new(0); valid = Hash.new(0); seasons = Hash.new { |h, k| h[k] = [ 0, 0.0 ] } # season => [valid days, snow water]
      (Date.new(2015, 7, 1)..Date.new(2025, 6, 30)).each do |d|
        a, b, t = swe[d.to_s], swe[(d - 1).to_s], temp[d.to_s]
        next unless a && b && t
        valid[d.month] += 1
        snow = a - b >= 0.1 && t <= 34
        hits[d.month] += 1 if snow
        if [ 11, 12, 1, 2, 3, 4 ].include?(d.month)
          s = d.month >= 7 ? d.year : d.year - 1
          seasons[s][0] += 1
          seasons[s][1] += a - b if snow
        end
      end
      full = seasons.select { |_, (n, _)| n >= 181 * 0.8 }
      next puts("#{slug}: only #{full.size} full seasons, skipped") if full.size < 8
      odds = r.ski_season_months.to_h { |m| [ m, valid[m].zero? ? 0 : (hits[m] * 100.0 / valid[m]).round ] }
      out["resorts"][slug] = { "odds" => odds, "seasons" => full.size, "snow_water_in" => (full.sum { |_, (_, g)| g } / full.size).round(1) }
      puts "#{slug}: #{odds.inspect} (#{full.size} seasons)"
      sleep 0.5
    end
    File.write(Rails.root.join("db/station_odds.yml"), out.to_yaml)
  end
end
