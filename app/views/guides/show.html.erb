<% faqs = [] %>
<% body = render(@guide.partial, faqs: faqs) %>
<% content_for(:title, @guide.title.length > 55 ? @guide.title : "#{@guide.title} | Snow Way") %>
<% content_for(:description, @guide.description) %>
<% content_for(:og_type, "article") %>
<% content_for(:og_extra) do %><meta property="article:published_time" content="<%= @guide.published_on.iso8601 %>" /><meta property="article:modified_time" content="<%= @guide.updated_on.iso8601 %>" /><meta property="article:author" content="https://snowway.app/authors/justin-mckelvey" /><% end %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
        { "@type" => "Article", "@id" => absolute_url("/guides/#{@guide.slug}#article"), "headline" => @guide.title, "description" => @guide.description,
          "url" => absolute_url("/guides/#{@guide.slug}"), "mainEntityOfPage" => absolute_url("/guides/#{@guide.slug}"),
          "image" => { "@type" => "ImageObject", "url" => image_url(@guide.hero[0]), "width" => @guide.hero[1], "height" => @guide.hero[2] },
          "author" => author_schema, "publisher" => { "@id" => "https://snowway.app/#organization" }, "isPartOf" => { "@id" => "https://snowway.app/#website" },
          "speakable" => { "@type" => "SpeakableSpecification", "cssSelector" => [ "h1", ".tldr" ] },
          "datePublished" => @guide.published_on.iso8601, "dateModified" => @guide.updated_on.iso8601 },
        breadcrumb_schema([ [ "Guides", "/guides" ], ([ @topic.name, "/guides/#{@topic.slug}" ] if @topic), [ @guide.title, nil ] ].compact),
        faq_schema(faqs)
      ].compact }) %>
<% end %>
<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <%= render "shared/breadcrumbs", crumbs: [ [ "Guides", guides_path ], ([ @topic.name, guide_topic_path(@topic.slug) ] if @topic), [ @guide.title, nil ] ].compact %>
    <article class="guide">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3"><%= @guide.title %></h1>
      <p class="text-slate-400 text-sm mb-4">By <%= link_to "Justin McKelvey", author_path, rel: "author", class: "text-slate-300 hover:text-white underline-offset-2 hover:underline" %> · Updated <time datetime="<%= @guide.updated_on.iso8601 %>"><%= @guide.updated_on.strftime("%B %-d, %Y") %></time></p>
      <% src, w, h, alt = @guide.hero %>
      <%= image_tag src, alt: alt, width: w, height: h, fetchpriority: "high", class: "w-full h-auto rounded-xl mb-6 aspect-[16/9] object-cover" %>
      <%= @guide.affiliate? ? affiliate_disclosure : tag.div(class: "mb-2") %>
      <%= body %>
      <% airport_deals = {
           "ski-trip-drive-or-fly" => { heading: "Flying? Compare flights and cars to the main ski airports", intro: "Mountain airports are closer to the slopes; big hubs usually have cheaper fares." },
           "winter-driving-to-ski-resorts" => { heading: "Rent an AWD or 4x4 at the ski airports", intro: "Ask for AWD or 4WD with snow-rated tires when you book.", cars: true },
           "ski-trip-cost" => { heading: "Price flights for your dates", intro: "Flights are often the biggest swing in a family ski budget. Compare a hub and a mountain airport." },
           "how-to-plan-a-ski-trip" => { heading: "Compare flights to the main ski airports" },
           "family-ski-trip" => { heading: "Compare flights to the main ski airports" },
           "colorado-ski-resorts-for-families" => { heading: "Flights and cars for a Colorado ski trip", codes: %w[DEN EGE HDN ASE] },
           "utah-ski-resorts-for-families" => { heading: "Flights and cars for a Utah ski trip", intro: "Most Utah resorts are within about an hour of Salt Lake City's airport.", codes: %w[SLC] },
           "california-ski-resorts-for-families" => { heading: "Flights and cars for a Lake Tahoe ski trip", codes: %w[RNO] },
           "vermont-ski-resorts-for-families" => { heading: "Flights and cars for a Vermont ski trip", codes: %w[BTV] }
         }[@guide.slug] %>
      <%= render "shared/airport_deals", **airport_deals if airport_deals %>
      <%= render "shared/local_take", take: LocalTake.for_guide(@guide.slug), subject: @guide.title.split(":").first %>
      <%= render "shared/planner_cta" if %w[ski-trip-packing-list what-to-wear-skiing how-to-ski how-to-snowboard how-to-chase-powder ski-lessons-for-adults rent-or-buy-ski-gear how-to-plan-a-ski-trip family-ski-trip ski-in-ski-out skiing-with-kids best-family-ski-resorts kids-ski-gear cheap-ski-trip holiday-ski-trips all-inclusive-ski-resorts ski-trip-cost ski-trip-drive-or-fly winter-driving-to-ski-resorts colorado-ski-resorts-for-families utah-ski-resorts-for-families california-ski-resorts-for-families vermont-ski-resorts-for-families].include?(@guide.slug) %>
    <%= render "shared/calendar_cta" %>
      <%= render "shared/faq", faqs: faqs, heading: "FAQ" %>
    </article>
    <%= render "shared/author_box" %>
    <% if @top.any? %>
      <aside class="bg-slate-800/40 border border-slate-700 rounded-xl p-5 mb-10" aria-labelledby="powder-now">
        <h2 id="powder-now" class="font-bold mb-3">Where the snow is this week</h2>
        <ol class="space-y-1 text-sm">
          <% @top.each_with_index do |r, i| %>
            <li class="flex justify-between"><span><%= i + 1 %>. <%= link_to r.name, resort_path(r), class: "hover:text-cyan-300" %> <span class="text-slate-400"><%= r.state_province %></span></span><span class="text-cyan-300 font-bold"><%= inches(@totals[r.id]) %></span></li>
          <% end %>
        </ol>
        <p class="mt-3 text-sm"><%= link_to "Full powder rankings →", resorts_path, class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %></p>
      </aside>
    <% end %>
    <% related = @guide.related %>
    <% if related.any? %>
      <nav aria-labelledby="related-guides" class="mb-6">
        <h2 id="related-guides" class="font-bold mb-3">Related guides</h2>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          <% related.each do |g| %><li><%= link_to g.title, guide_path(g), class: "block bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-cyan-500 rounded-lg px-3 py-2 transition" %></li><% end %>
        </ul>
      </nav>
    <% end %>
    <p class="text-sm text-slate-400"><% if @topic %><%= link_to "All #{@topic.name.downcase}", guide_topic_path(@topic.slug), class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %> · <% end %><%= link_to "All guides", guides_path, class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %></p>
  </main>
</div>
