<% content_for(:title, "Ski & Snowboard Guides: Sizing, How-To & Gear | Snow Way") %>
<% content_for(:description, "Ski and snowboard guides: size calculators, first-day how-tos, gear buying guides for boots, goggles, jackets and more, and head-to-head comparisons.") %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [ breadcrumb_schema([ [ "Guides", nil ] ]),
        { "@type" => "ItemList", "itemListElement" => @guides.each_with_index.map { |g, i| { "@type" => "ListItem", "position" => i + 1, "name" => g.title, "url" => absolute_url("/guides/#{g.slug}") } } } ] }) %>
<% end %>
<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <%= render "shared/breadcrumbs", crumbs: [ [ "Guides", nil ] ] %>
    <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Ski &amp; snowboard guides</h1>
    <p class="text-slate-300 mb-8">Straight answers for skiers and snowboarders: sizing, first-day how-tos, gear buying guides, and head-to-head comparisons.</p>
    <h2 class="text-xl font-bold mb-3">Sizing tools</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10">
      <li><%= link_to snowboard_size_chart_path, class: "block bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 rounded-xl p-5 transition" do %><span class="font-bold text-lg block">Snowboard size calculator</span><span class="text-slate-300 text-sm">Board length by height, weight, and style, plus width by boot size.</span><% end %></li>
      <li><%= link_to ski_size_chart_path, class: "block bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 rounded-xl p-5 transition" do %><span class="font-bold text-lg block">Ski size calculator</span><span class="text-slate-300 text-sm">Ski length by height, ability, and terrain, plus pole length.</span><% end %></li>
    </ul>
    <% @guides.group_by(&:category).sort_by { |cat, _| Guide::CATEGORIES.keys.index(cat) }.each do |cat, guides| %>
      <h2 class="text-xl font-bold mb-3"><%= Guide::CATEGORIES[cat] %></h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10">
        <% guides.each do |g| %>
          <li><%= link_to guide_path(g), class: "block h-full bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-cyan-500 rounded-xl p-5 transition" do %>
            <span class="font-bold block mb-1"><%= g.title %></span><span class="text-slate-300 text-sm"><%= g.description %></span>
          <% end %></li>
        <% end %>
      </ul>
    <% end %>
  </main>
</div>
