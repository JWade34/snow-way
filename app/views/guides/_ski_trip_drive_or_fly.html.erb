  [ "ASE", "Aspen/Pitkin County", %w[aspen-snowmass], "Minutes from Aspen and Snowmass. Mountain weather means flights can be delayed or diverted." ],
  [ "HDN", "Yampa Valley (Hayden)", %w[steamboat], "About 25 miles from Steamboat, with seasonal direct flights from big hubs." ],
  [ "JAC", "Jackson Hole", %w[jackson-hole], "Inside Grand Teton National Park, roughly 30 minutes from Teton Village." ],
  [ "BZN", "Bozeman Yellowstone", %w[big-sky], "About 50 miles to Big Sky, roughly an hour through Gallatin Canyon in good conditions." ],
  [ "SLC", "Salt Lake City", %w[snowbird solitude park-city], "A major hub with many resorts within about an hour. Canyon roads can still back up on storm days." ],
