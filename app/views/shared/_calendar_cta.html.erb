<aside class="mb-10 bg-slate-800/40 border border-slate-700 rounded-xl p-4 flex flex-wrap sm:flex-nowrap items-center gap-4" aria-labelledby="calendar-cta-heading">
  <%= image_tag "powder-calendar-cover.webp", alt: "", width: 260, height: 336, loading: "lazy", class: "w-14 sm:w-20 rounded shadow-lg -rotate-3 shrink-0" %>
  <div class="flex-1 min-w-0">
    <p id="calendar-cta-heading" class="font-bold text-base sm:text-lg leading-snug">Free: the <%= PowderCalendarPdf.season_label %> Powder Calendar</p>
    <p class="text-slate-300 text-sm">When the snow really falls at all <%= Resort.north_america.count %> North American resorts, plus early-season, holiday, and spring picks.</p>
  </div>
  <%= link_to "Get it free →", powder_calendar_path, class: "w-full sm:w-auto shrink-0 bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold rounded-lg px-4 py-2.5 text-center transition text-sm" %>
</aside>
