<%# extra is an optional lambda ->(resort) { value } for one more column -%>
<%# locals: (resorts:, totals:, extra: nil, extra_label: nil, caption:) -%>
<div class="overflow-x-auto border border-slate-700 rounded-xl">
  <table class="w-full text-sm">
    <caption class="sr-only"><%= caption %></caption>
    <thead class="bg-slate-800/70 text-slate-300 text-left">
      <tr>
        <th scope="col" class="px-3 py-2 font-semibold">#</th>
        <th scope="col" class="px-3 py-2 font-semibold">Resort</th>
        <th scope="col" class="px-3 py-2 font-semibold text-right">7-day snow</th>
        <% if extra %><th scope="col" class="px-3 py-2 font-semibold text-right"><%= extra_label %></th><% end %>
        <th scope="col" class="px-3 py-2 font-semibold text-right hidden sm:table-cell">Summit</th>
        <th scope="col" class="px-3 py-2 font-semibold hidden sm:table-cell">Pass</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <% resorts.each_with_index do |resort, i| %>
        <tr class="hover:bg-slate-800/40">
          <td class="px-3 py-2 text-slate-400"><%= i + 1 %></td>
          <td class="px-3 py-2"><%= link_to resort.name, resort_path(resort), class: "font-semibold text-white hover:text-cyan-300 underline-offset-2 hover:underline" %><span class="block text-xs text-slate-400"><%= resort.state_province %></span></td>
          <td class="px-3 py-2 text-right font-bold text-cyan-300"><%= inches(totals.fetch(resort.id, 0.0)) %></td>
          <% if extra %><td class="px-3 py-2 text-right text-slate-200"><%= extra.call(resort) %></td><% end %>
          <td class="px-3 py-2 text-right text-slate-300 hidden sm:table-cell"><%= number_with_delimiter(resort.elevation_summit) %> ft</td>
          <td class="px-3 py-2 text-slate-300 hidden sm:table-cell"><%= resort.pass_label || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
