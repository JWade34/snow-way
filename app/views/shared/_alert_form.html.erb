<%# locals: (resort: nil) -%>
<section id="alert-form" class="mb-10 bg-gradient-to-r from-cyan-500/10 to-slate-800/40 border border-cyan-500/30 rounded-xl p-5" aria-labelledby="alert-heading">
  <h2 id="alert-heading" class="text-lg font-bold mb-1"><%= resort ? "Get a #{resort.name} powder alert" : "Get powder alerts" %></h2>
  <p class="text-slate-300 text-sm mb-4"><%= resort ? "We'll email you when #{resort.name}'s forecast calls for a big dump." : "We'll email you when a big storm lines up anywhere Snow Way tracks." %> You'll also get our free weekly snow report on Thursdays. No spam, unsubscribe anytime.</p>
  <%= form_with model: Subscriber.new, url: subscribers_path, class: "flex flex-col sm:flex-row gap-2" do |f| %>
    <%= f.hidden_field :resort_id, value: resort&.id %>
    <%= f.label :email, "Email address", class: "sr-only" %>
    <%= f.email_field :email, required: true, placeholder: "you@example.com", autocomplete: "email", class: "flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" %>
    <% if resort %>
      <%= f.label :threshold_inches, "Alert me at", class: "sr-only" %>
      <%= f.select :threshold_inches, [ [ "6\"+ forecast", 6 ], [ "12\"+ forecast", 12 ], [ "18\"+ forecast", 18 ] ], {}, class: "bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-white" %>
    <% end %>
    <%= f.submit "Alert me", class: "bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold rounded-lg px-5 py-2 cursor-pointer transition" %>
  <% end %>
</section>
