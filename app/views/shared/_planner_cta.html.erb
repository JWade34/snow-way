<aside id="ski-trip-planner-form" class="my-10 grid sm:grid-cols-[auto_1fr] gap-4 items-center bg-gradient-to-r from-cyan-500/10 to-slate-800/40 border border-cyan-500/30 rounded-xl p-5" aria-labelledby="planner-heading">
  <%= image_tag "planner-cover.webp", alt: "", width: 260, height: 336, loading: "lazy", class: "hidden sm:block w-24 rounded shadow-lg -rotate-3" %>
  <div>
    <p id="planner-heading" class="font-bold text-lg mb-1 text-white">Free printable Ski Trip Planner</p>
    <p class="text-slate-300 text-sm mb-3">Countdown timeline, best hub cities, pass guide, budget worksheet, and packing checklist. Instant download.</p>
    <%= form_with model: Subscriber.new, url: subscribers_path, class: "flex flex-col sm:flex-row gap-2" do |f| %>
      <%= f.hidden_field :magnet, value: "ski-trip-planner" %>
      <%= f.label :email, "Email address", class: "sr-only", for: "planner_email_#{local_assigns[:suffix]}" %>
      <%= f.email_field :email, id: "planner_email_#{local_assigns[:suffix]}", required: true, placeholder: "you@example.com", autocomplete: "email", class: "flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" %>
      <%= f.submit "Get the planner", class: "bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold rounded-lg px-5 py-2 cursor-pointer transition" %>
    <% end %>
    <p class="text-slate-400 text-xs mt-2">We'll also send powder alerts for big storms and a weekly snow report on Thursdays; unsubscribe anytime.</p>
  </div>
</aside>
