<div id="calendar-form">
  <%= form_with model: Subscriber.new, url: subscribers_path, class: "flex flex-col sm:flex-row gap-2" do |f| %>
    <%= f.hidden_field :magnet, value: "powder-calendar" %>
    <%= f.label :email, "Email address", class: "sr-only", for: "calendar_email" %>
    <%= f.email_field :email, id: "calendar_email", required: true, placeholder: "you@example.com", autocomplete: "email", class: "flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" %>
    <%= f.submit "Get the free PDF", class: "bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold rounded-lg px-5 py-2 cursor-pointer transition" %>
  <% end %>
  <p class="text-slate-400 text-xs mt-2">Instant download. We'll also send powder alerts for big storms; unsubscribe anytime.</p>
</div>
