<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% (SitePages.static_paths + SitePages.optional_paths + SitePages.region_paths + SitePages.hub_paths).each do |path| %>
  <url><loc><%= SitePages.url(path) %></loc><lastmod><%= @latest.iso8601 %></lastmod></url>
<% end %>
<% @resorts.each do |resort| %>
  <url><loc><%= SitePages.url("/resorts/#{resort.slug}") %></loc><lastmod><%= (@forecast_updated[resort.id] || resort.updated_at).to_date.iso8601 %></lastmod></url>
  <url><loc><%= SitePages.url("/resorts/#{resort.slug}/best-time-to-ski") %></loc><lastmod><%= resort.updated_at.to_date.iso8601 %></lastmod></url>
<% end %>
<% SitePages.lodging_paths(@resorts).each do |path| %>
  <url><loc><%= SitePages.url(path) %></loc><lastmod>2026-11-07</lastmod></url>
<% end %>
<% SitePages.report_paths.each do |path| %>
  <url><loc><%= SitePages.url(path) %></loc><lastmod><%= path.split("/").last %></lastmod></url>
<% end %>
<% SitePages.guide_paths.each do |path| %>
  <url><loc><%= SitePages.url(path) %></loc><lastmod>2026-11-05</lastmod></url>
<% end %>
</urlset>
