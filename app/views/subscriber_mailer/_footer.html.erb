<% if TipJar.enabled? %>
<p style="margin:20px 0 0;font-size:14px;color:#334155;">Snow Way is free with no ads. If it found you a powder day:
  <% TipJar.options.each_with_index do |o, i| %><%= " · " if i.positive? %><a href="<%= o.url %>" style="color:#0891b2;font-weight:600;"><%= o.label %><%= " (#{o.price})" if o.price %></a><% end %></p>
<% end %>
<p style="margin:24px 0 0;padding-top:16px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;">
  You're getting this because you signed up at snowway.app.
  <% if @subscriber&.weekly_report %><a href="https://snowway.app/weekly/<%= @subscriber.token %>" style="color:#64748b;">Stop the weekly report</a> · <% elsif @subscriber %><a href="https://snowway.app/weekly/<%= @subscriber.token %>" style="color:#64748b;">Get the free weekly snow report too</a> · <% end %><a href="<%= @unsubscribe_url %>" style="color:#64748b;">Unsubscribe</a><br><%= ENV.fetch("MAIL_POSTAL_ADDRESS", "Fast City LLC · 6705 W Highway 290, Suite 607 PMB 1096 · Austin, TX 78735-8407") %>
</p>
