<% content_for(:title, "Gear closet") %>
<div class="flex items-center justify-between gap-3 mb-4">
  <h1 class="text-2xl font-extrabold">Gear closet</h1>
  <%= link_to "+ Add gear", new_admin_gear_item_path, class: "bg-cyan-400 text-slate-900 font-bold rounded-lg px-4 py-2 text-sm" %>
</div>
<p class="text-slate-400 text-sm mb-4">Private inventory. Only items you mark public appear on <%= GearItem.visible.exists? ? link_to("/what-i-ride", gear_path, class: "underline", target: "_blank") : "/what-i-ride (goes live once one item is public)" %>.</p>
<nav class="flex flex-wrap gap-2 text-xs mb-6">
  <%= link_to "All", admin_gear_items_path, class: "rounded-full px-3 py-1 #{@status ? "bg-slate-800" : "bg-cyan-400 text-slate-900 font-bold"}" %>
  <% GearItem::STATUSES.each do |key, label| %>
    <%= link_to label, admin_gear_items_path(status: key), class: "rounded-full px-3 py-1 #{@status == key ? "bg-cyan-400 text-slate-900 font-bold" : "bg-slate-800"}" %>
  <% end %>
</nav>
<% if @groups.empty? %>
  <p class="text-slate-400">Nothing here yet. Start with what you'd grab for a powder day tomorrow.</p>
<% end %>
<% @groups.each do |category, items| %>
  <h2 class="text-sm font-bold text-cyan-300 mt-6 mb-2"><%= category %></h2>
  <ul class="divide-y divide-slate-800 border border-slate-800 rounded-xl">
    <% items.each do |item| %>
      <li class="flex items-center justify-between gap-3 px-4 py-3">
        <div class="min-w-0">
          <%= link_to item.name, edit_admin_gear_item_path(item), class: "font-semibold hover:text-cyan-300" %>
          <span class="text-xs text-slate-500"><%= [ item.season, item.size ].compact_blank.join(" · ") %></span>
          <% if item.notes.present? %><p class="text-slate-400 text-xs truncate"><%= item.notes %></p><% end %>
        </div>
        <div class="shrink-0 flex gap-2 text-xs">
          <span class="rounded-full px-2 py-1 bg-slate-800 text-slate-300"><%= item.status_label %></span>
          <% if item.public? %><span class="rounded-full px-2 py-1 bg-emerald-500/20 text-emerald-300">Public</span><% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
