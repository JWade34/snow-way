<% content_for(:title, "Subscribers") %>
<% active = @subscribers.select { |s| s.unsubscribed_at.nil? } %>
<div class="flex items-center justify-between gap-3 mb-4">
  <h1 class="text-2xl font-extrabold">Subscribers</h1>
  <%= link_to "Download CSV", admin_subscribers_path(format: :csv), class: "bg-slate-700 font-bold rounded-lg px-4 py-2 text-sm" %>
</div>
<p class="text-slate-400 text-sm mb-6"><%= active.map(&:email).uniq.size %> active emails · <%= @subscribers.count { |s| s.unsubscribed_at } %> unsubscribed · <%= @subscribers.count { |s| s.created_at > 7.days.ago } %> signups this week</p>
<div class="overflow-x-auto border border-slate-800 rounded-xl">
  <table class="w-full text-sm">
    <thead class="text-left text-slate-400 bg-slate-800/50"><tr><th class="px-3 py-2">Email</th><th class="px-3 py-2">Signed up for</th><th class="px-3 py-2">Date</th><th class="px-3 py-2">Status</th></tr></thead>
    <tbody class="divide-y divide-slate-800">
      <% @subscribers.each do |s| %>
        <tr>
          <td class="px-3 py-2"><%= s.email %></td>
          <td class="px-3 py-2 text-slate-300"><%= [ s.source&.humanize, s.resort&.name, (s.threshold_inches && "#{s.threshold_inches}\"+ alerts") ].compact_blank.join(" · ") %></td>
          <td class="px-3 py-2 text-slate-400 whitespace-nowrap"><%= s.created_at.to_date.strftime("%b %-d, %Y") %></td>
          <td class="px-3 py-2"><%= s.unsubscribed_at ? "Unsubscribed" : s.welcomed_at ? "Active" : "Signed up" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
