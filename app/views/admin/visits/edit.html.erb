<% content_for(:title, @resort.name) %>
<p class="text-sm mb-2"><%= link_to "← All resorts", admin_visits_path, class: "text-slate-400 hover:text-cyan-300" %></p>
<h1 class="text-2xl font-extrabold mb-1"><%= @resort.name %></h1>
<p class="text-slate-400 text-sm mb-6"><%= @resort.region_name %> · <%= link_to "View page ↗", resort_path(@resort), class: "underline", target: "_blank" %></p>
<%= form_with model: @visit, url: admin_visit_path(@resort.slug), method: :patch, class: "space-y-5" do |f| %>
  <% if @visit.errors.any? %><p class="text-red-300 text-sm"><%= @visit.errors.full_messages.to_sentence %></p><% end %>
  <div>
    <%= f.label :take, "Your take (one to three sentences: who it's for, what makes it great, what to skip)", class: "block text-sm font-semibold mb-1" %>
    <%= f.text_area :take, rows: 5, class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2" %>
  </div>
  <div>
    <%= f.label :tips, "Tips (one per line, optional)", class: "block text-sm font-semibold mb-1" %>
    <%= f.text_area :tips, rows: 4, placeholder: "Park at the bottom lot before 8 on a powder day", class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :when_ridden, "When (private)", class: "block text-sm font-semibold mb-1" %>
      <%= f.text_field :when_ridden, placeholder: "Lived there 2012–14", class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2" %>
    </div>
    <div>
      <%= f.label :rating, "Your rating (private)", class: "block text-sm font-semibold mb-1" %>
      <%= f.select :rating, [ [ "—", nil ] ] + (1..5).map { |n| [ "★" * n, n ] }, {}, class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2" %>
    </div>
  </div>
  <label class="flex items-start gap-3 bg-slate-800/60 border border-slate-700 rounded-lg p-3 cursor-pointer">
    <%= f.check_box :published, class: "accent-cyan-400 w-5 h-5 mt-0.5" %>
    <span><strong>Publish</strong><span class="block text-slate-400 text-sm">Shows your take and tips on the <%= @resort.name %> page and lists it on your author page. When and rating stay private.</span></span>
  </label>
  <%= f.submit "Save", class: "bg-cyan-400 text-slate-900 font-bold rounded-lg px-5 py-2 cursor-pointer" %>
<% end %>
