<% content_for(:title, "Snow Way — Which Ski Resort Is Getting the Most Snow?") %>
<% if @top_resort %>
  <% content_for(:description, "#{@top_resort.name} leads with #{@top_resort.projected_snowfall_7_day}\" of snow projected in the next 7 days. Find the best powder conditions at North American ski resorts.") %>
<% else %>
  <% content_for(:description, "Find the ski resort getting the most snow in the next 7 days. Real-time powder forecasts for North American ski resorts.") %>
<% end %>

<% content_for(:head) do %>
  <%# AvantLink website verification (application 1678401). Remove once the application is confirmed. %>
  <script type="text/javascript" src="http://classic.avantlink.com/affiliate_app_confirm.php?mode=js&authResponse=bf454a9c914d90212cbcab96fe4c92f9ad1b3d8c"></script>
  <%= json_ld({ "@context" => "https://schema.org" }.merge(faq_schema(@faqs))) if @faqs.any? %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Snow Way",
    "url": "https://snowway.app",
    "description": "Find the ski resort getting the most snow in the next 7 days. Chase the powder with one tap.",
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Web",
    "author": {
      "@type": "Person",
      "@id": "https://justinmckelvey.com/#person",
      "name": "Justin McKelvey",
      "url": "https://snowway.app/authors/justin-mckelvey",
      "sameAs": ["https://justinmckelvey.com", "https://www.linkedin.com/in/justinmckelvey"]
    },
    "creator": { "@id": "https://justinmckelvey.com/#person" }
  }
  </script>
<% end %>

<% if @top_resorts.present? %>
  <% content_for(:head) do %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Top Powder Destinations",
      "description": "North American ski resorts ranked by projected snowfall in the next 7 days",
      "numberOfItems": <%= @top_resorts.size %>,
      "itemListElement": [
        <% @top_resorts.each_with_index do |resort, index| %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "name": "<%= j resort.name %>",
          "url": "https://snowway.app/resorts/<%= resort.slug %>"
        }<%= index < @top_resorts.size - 1 ? ',' : '' %>
        <% end %>
      ]
    }
    </script>
  <% end %>
<% end %>

<div class="min-h-screen flex flex-col" data-controller="snowflakes">
  <!-- Snowflakes container -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" data-snowflakes-target="container"></div>
  <%= render "shared/header" %>

  <!-- Hero Section -->
  <main id="main" class="relative z-10 flex-1 flex flex-col items-center justify-center px-6 pt-8 pb-20">
    <h1 class="text-xl md:text-2xl font-bold text-center text-slate-200 max-w-2xl mb-2">Which ski resort is getting the most snow this week?</h1>
    <p class="text-slate-400 text-sm md:text-base text-center max-w-xl mb-10">
      Snow Way ranks <%= @resort_count %> North American ski resorts by forecast snowfall for the next 7 days, updated every 6 hours.
      <% if @top_resort %>Right now, <strong class="text-slate-200"><%= @top_resort.name %></strong> leads with <%= @top_resort.projected_snowfall_7_day %>" at mid-mountain.<% end %>
    </p>
    <% if @top_resort %>
      <p class="text-cyan-300 text-sm uppercase tracking-widest mb-2">#1 for powder this week</p>

      <h2 class="text-4xl md:text-6xl font-extrabold text-center mb-4">
        <%= @top_resort.name %>
      </h2>

      <p class="text-slate-400 mb-8">
        <%= @top_resort.state_province %>, <%= @top_resort.country %>
      </p>

      <!-- Recent Snowfall Badge -->
      <% if @top_resort.recent_snowfall_48h > 0 %>
        <div class="bg-amber-500/20 border border-amber-500/30 rounded-lg px-4 py-2 mb-6">
          <span class="text-amber-400 font-bold"><%= @top_resort.recent_snowfall_48h %>"</span>
          <span class="text-slate-400 text-sm">fresh in 48h</span>
        </div>
      <% end %>

      <!-- Big Snow Number -->
      <div class="relative mb-8">
        <div class="text-8xl md:text-9xl font-extrabold text-transparent bg-clip-text bg-gradient-to-b from-white to-cyan-300" data-controller="counter" data-counter-target-value="<%= @top_resort.projected_snowfall_7_day %>">
          <span data-counter-target="number">0</span><span class="text-5xl">"</span>
        </div>
        <p class="text-center text-slate-400 mt-2">mid-mountain, next 7 days</p>
      </div>

      <!-- Quick Stats -->
      <div class="flex gap-6 sm:gap-8 mb-10 text-center">
        <div>
          <p class="text-2xl font-bold"><%= @top_resort.nearest_airport_code %></p>
          <p class="text-slate-400 text-sm">Nearest Airport</p>
        </div>
        <div>
          <p class="text-2xl font-bold"><%= number_with_delimiter(@top_resort.elevation_summit) %>'</p>
          <p class="text-slate-400 text-sm">Summit</p>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <%= link_to resort_path(@top_resort), class: "bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold py-4 px-8 rounded-xl text-lg transition transform hover:scale-105 text-center" do %>
          SEND IT
        <% end %>

        <%= link_to resorts_path, class: "border border-slate-600 hover:border-slate-400 text-white font-semibold py-4 px-8 rounded-xl text-lg transition text-center" do %>
          Explore All Resorts
        <% end %>
      </div>

    <% else %>
      <div class="text-center">
        <p class="text-6xl mb-4">:(</p>
        <h2 class="text-2xl font-bold mb-2">No storms in sight...</h2>
        <p class="text-slate-400">Check back later for powder alerts!</p>
      </div>
    <% end %>
  </main>

  <!-- Bottom Preview -->
  <% if @top_resorts.present? %>
    <section class="relative z-10 px-6 pb-8">
      <p class="text-slate-400 text-sm uppercase tracking-widest mb-4 text-center">Top 5 Powder Destinations</p>
      <div class="flex flex-wrap justify-center gap-3">
        <% @top_resorts.each_with_index do |resort, index| %>
          <%= link_to resort_path(resort), class: "bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 rounded-lg px-4 py-2 transition flex items-center gap-2" do %>
            <span class="text-cyan-400 font-bold"><%= index + 1 %>.</span>
            <span class="font-medium"><%= resort.name %></span>
            <% if resort.recent_snowfall_48h > 0 %>
              <span class="text-amber-400"><%= resort.recent_snowfall_48h %>"</span>
              <span class="text-slate-400">/</span>
            <% end %>
            <span class="text-cyan-400"><%= resort.projected_snowfall_7_day %>"</span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- How it works + FAQ: the plain-language answers search engines and AI assistants quote -->
  <section class="relative z-10 max-w-4xl w-full mx-auto px-6 pb-12">
    <h2 class="text-xl font-bold mb-4">How Snow Way works</h2>
    <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
      <li class="bg-slate-800/40 border border-slate-700 rounded-lg p-4"><p class="font-semibold mb-1">1. Forecast every resort</p><p class="text-slate-300 text-sm">We pull a 16-day snowfall forecast for each resort at mid-mountain and the summit from Open-Meteo, every 6 hours.</p></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-lg p-4"><p class="font-semibold mb-1">2. Rank by 7-day snow</p><p class="text-slate-300 text-sm">Resorts are ranked by total snow expected over the next 7 days, the range where forecasts are most useful.</p></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-lg p-4"><p class="font-semibold mb-1">3. Book the trip</p><p class="text-slate-300 text-sm">Every resort page links flights, 4x4 rentals, and hotels near the mountain for the dates you need.</p></li>
    </ol>
    <div class="flex flex-wrap gap-2 mb-10 text-sm">
      <%= link_to "Where is it snowing?", where_is_it_snowing_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
      <%= link_to "Ski resorts by state", regions_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
      <%= link_to "Ikon vs Epic", ikon_vs_epic_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
      <%= link_to "Opening dates", opening_dates_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
    </div>
    <%= render "shared/alert_form" %>
    <%= render "shared/calendar_cta" %>
    <%= render "shared/faq", faqs: @faqs, heading: "Frequently asked questions" %>
  </section>
</div>
