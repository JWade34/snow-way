<% content_for(:title, "Snow Way — Which Ski Resort Is Getting the Most Snow?") %>
<% if @top_resort %>
  <% content_for(:description, "#{@top_resort.name} leads with #{@top_resort.projected_snowfall_7_day}\" of snow projected in the next 7 days. Find the best powder conditions at North American ski resorts.") %>
<% else %>
  <% content_for(:description, "Find the ski resort getting the most snow in the next 7 days. Real-time powder forecasts for North American ski resorts.") %>
<% end %>

<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org" }.merge(faq_schema(@faqs))) if @faqs.any? %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Snow Way",
    "url": "https://snowway.app",
    "description": "Find the ski resort getting the most snow in the next 7 days. Chase the powder with one tap.",
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Web",
    "author": {
      "@type": "Person",
      "@id": "https://justinmckelvey.com/#person",
      "name": "Justin McKelvey",
      "url": "https://snowway.app/authors/justin-mckelvey",
      "sameAs": ["https://justinmckelvey.com", "https://www.linkedin.com/in/justinmckelvey"]
    },
    "creator": { "@id": "https://justinmckelvey.com/#person" }
  }
  </script>
<% end %>

<% if @top_resorts.present? %>
  <% content_for(:head) do %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Top Powder Destinations",
      "description": "North American ski resorts ranked by projected snowfall in the next 7 days",
      "numberOfItems": <%= @top_resorts.size %>,
      "itemListElement": [
        <% @top_resorts.each_with_index do |resort, index| %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "name": "<%= j resort.name %>",
          "url": "https://snowway.app/resorts/<%= resort.slug %>"
        }<%= index < @top_resorts.size - 1 ? ',' : '' %>
        <% end %>
      ]
    }
    </script>
  <% end %>
<% end %>

<div class="min-h-screen flex flex-col" data-controller="snowflakes">
  <!-- Snowflakes container -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" data-snowflakes-target="container"></div>
  <%= render "shared/header" %>

  <!-- Hero: answer, a resort search for people who already picked a mountain, then this week's #1 -->
  <main id="main" class="relative z-10 w-full max-w-xl mx-auto px-4 pt-6 pb-10">
    <h1 class="text-2xl md:text-3xl font-extrabold text-center leading-tight mb-2">Which ski resort is getting the most snow this week?</h1>
    <p class="text-slate-400 text-sm text-center mb-5">Snow Way ranks <%= @resort_count %> North American ski resorts by 7-day forecast snow, updated every 6 hours.</p>

    <form action="<%= resorts_path %>" class="mb-6" data-controller="resort-search" data-action="submit->resort-search#go" role="search">
      <label for="resort-search" class="block text-sm font-semibold text-slate-200 mb-2">Already know where you're going?</label>
      <div class="flex gap-2">
        <input id="resort-search" type="search" list="resort-options" placeholder="Search a resort" autocomplete="off" data-resort-search-target="input" data-action="change->resort-search#go"
               class="flex-1 min-w-0 bg-slate-800 border border-slate-600 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400">
        <button type="submit" class="shrink-0 bg-slate-700 hover:bg-slate-600 rounded-xl px-4 font-semibold transition">Go</button>
      </div>
      <datalist id="resort-options">
        <% @search_resorts.each do |name, slug| %><option value="<%= name %>" data-slug="<%= slug %>"></option><% end %>
      </datalist>
    </form>

    <% if @top_resort %>
      <% total = @top_resort.projected_snowfall_7_day %>
      <section class="bg-slate-800/60 border border-slate-700 rounded-2xl p-5 text-center mb-6" aria-labelledby="top-resort">
        <p class="text-cyan-300 text-xs font-semibold uppercase tracking-widest mb-1">#1 for powder this week</p>
        <h2 id="top-resort" class="text-3xl md:text-4xl font-extrabold leading-tight"><%= @top_resort.name %></h2>
        <p class="text-slate-400 text-sm mb-3"><%= @top_resort.state_province %>, <%= @top_resort.country %></p>
        <p class="text-7xl md:text-8xl font-extrabold text-cyan-300 leading-none">
          <span class="relative inline-block"><%= total %><span class="absolute left-full top-1 ml-1 text-4xl md:text-5xl" aria-hidden="true">"</span></span><span class="sr-only"> inches</span>
        </p>
        <p class="text-slate-400 text-sm mt-2 mb-4">forecast over the next 7 days (mid-mountain)</p>
        <dl class="grid grid-cols-3 gap-2 text-center mb-5">
          <div class="bg-slate-900/50 rounded-lg py-2"><dt class="text-slate-400 text-xs">Last 48 hrs</dt><dd class="font-bold <%= @top_resort.recent_snowfall_48h > 0 ? "text-amber-400" : "" %>"><%= @top_resort.recent_snowfall_48h %>"</dd></div>
          <div class="bg-slate-900/50 rounded-lg py-2"><dt class="text-slate-400 text-xs">Fly into</dt><dd class="font-bold"><%= @top_resort.nearest_airport_code %></dd></div>
          <div class="bg-slate-900/50 rounded-lg py-2"><dt class="text-slate-400 text-xs">Summit</dt><dd class="font-bold"><%= number_with_delimiter(@top_resort.elevation_summit) %>'</dd></div>
        </dl>
        <div class="grid grid-cols-2 gap-3">
          <%= link_to "See the forecast", resort_path(@top_resort), class: "bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold py-3 rounded-xl transition" %>
          <%= link_to "All rankings", resorts_path, class: "border border-slate-600 hover:border-slate-400 font-semibold py-3 rounded-xl transition" %>
        </div>
      </section>
      <%= render "shared/storm_deal", resort: @top_resort, summary: @top_summary, css: "mb-6" %>
    <% else %>
      <section class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6 text-center mb-6">
        <h2 class="text-xl font-bold mb-2">No big storms in the forecast yet</h2>
        <p class="text-slate-400 text-sm">Search your resort above, or get an email when a big storm lines up.</p>
      </section>
    <% end %>

    <% if @top_resorts.present? %>
      <section aria-labelledby="top-five">
        <div class="flex items-baseline justify-between mb-2">
          <h2 id="top-five" class="text-sm font-semibold uppercase tracking-widest text-slate-400">Most snow this week</h2>
          <%= link_to "Full rankings →", resorts_path, class: "text-sm text-cyan-300 hover:text-cyan-200" %>
        </div>
        <ol class="space-y-2">
          <% @top_resorts.each_with_index do |resort, index| %>
            <li>
              <%= link_to resort_path(resort), class: "flex items-center gap-3 bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-cyan-500 rounded-xl px-4 py-3 transition" do %>
                <span class="text-cyan-400 font-bold w-5"><%= index + 1 %></span>
                <span class="flex-1 min-w-0"><span class="font-semibold block truncate"><%= resort.name %></span><span class="text-slate-400 text-xs"><%= resort.state_province %></span></span>
                <span class="text-cyan-300 font-bold"><%= resort.projected_snowfall_7_day %>"</span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  </main>

  <!-- How it works + FAQ: the plain-language answers search engines and AI assistants quote -->
  <section class="relative z-10 max-w-4xl w-full mx-auto px-6 pb-12">
    <h2 class="text-xl font-bold mb-4">How Snow Way works</h2>
    <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
      <li class="bg-slate-800/40 border border-slate-700 rounded-lg p-4"><p class="font-semibold mb-1">1. Forecast every resort</p><p class="text-slate-300 text-sm">We pull a 16-day snowfall forecast for each resort at mid-mountain and the summit from Open-Meteo, every 6 hours.</p></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-lg p-4"><p class="font-semibold mb-1">2. Rank by 7-day snow</p><p class="text-slate-300 text-sm">Resorts are ranked by total snow expected over the next 7 days, the range where forecasts are most useful.</p></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-lg p-4"><p class="font-semibold mb-1">3. Book the trip</p><p class="text-slate-300 text-sm">Every resort page links flights, 4x4 rentals, and hotels near the mountain for the dates you need.</p></li>
    </ol>
    <div class="flex flex-wrap gap-2 mb-10 text-sm">
      <%= link_to "Where is it snowing?", where_is_it_snowing_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
      <%= link_to "Ski resorts by state", regions_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
      <%= link_to "Ikon vs Epic", ikon_vs_epic_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
      <%= link_to "Opening dates", opening_dates_path, class: "bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2 transition" %>
    </div>
    <%= render "shared/alert_form" %>
    <%= render "shared/calendar_cta" %>
    <%= render "shared/faq", faqs: @faqs, heading: "Frequently asked questions" %>
  </section>
</div>
