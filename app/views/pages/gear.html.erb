<% content_for(:title, "What I Ride: Justin McKelvey's Snow Gear | Snow Way") %>
<% content_for(:description, "The boards, boots, bindings, and outerwear Justin McKelvey actually rides, from a former snowboard shop owner and Vail local, with an honest note on each.") %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
        { "@type" => "WebPage", "url" => absolute_url("/what-i-ride"), "name" => "What I ride", "author" => author_schema },
        breadcrumb_schema([ [ "Justin McKelvey", "/authors/justin-mckelvey" ], [ "What I ride", nil ] ]) ] }) %>
<% end %>
<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <%= render "shared/breadcrumbs", crumbs: [ [ "Justin McKelvey", author_path ], [ "What I ride", nil ] ] %>
    <h1 class="text-3xl md:text-4xl font-extrabold mb-3">What I ride</h1>
    <p class="text-slate-300 mb-2">The gear I actually own and use, from someone who used to run a snowboard shop. No free samples, no paid spots, just what's in my closet and what I think of it.</p>
    <p class="text-slate-400 text-xs mb-8">Shop links are affiliate links: Snow Way may earn a commission at no cost to you. <%= link_to "Disclosure", affiliate_disclosure_path, class: "underline" %>.</p>
    <% GearItem.by_category(@items).each do |category, items| %>
      <h2 class="text-xl font-bold mt-8 mb-3"><%= category %></h2>
      <ul class="space-y-3">
        <% items.each do |item| %>
          <li class="bg-slate-800/40 border border-slate-700 rounded-xl p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-bold"><%= item.name %></h3>
              <span class="text-xs text-slate-400"><%= [ item.season, item.size, item.status_label ].compact_blank.join(" · ") %></span>
            </div>
            <% if item.public_note.present? %><p class="text-slate-300 text-sm mt-2"><%= item.public_note %></p><% end %>
            <% unless item.status.in?(%w[sold retired]) %>
              <p class="mt-3 text-sm"><%= link_to "Check price ↗", Affiliate.gear_url(item.name), rel: "sponsored nofollow noopener", target: "_blank", class: "text-cyan-300 underline" %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="text-slate-400 text-sm mt-10">Picking your own? Start with the <%= link_to "snowboard size chart", snowboard_size_chart_path, class: "underline" %> or the <%= link_to "gear guides", guide_topic_path("gear"), class: "underline" %>.</p>
  </main>
</div>
