<% content_for(:title, "About Snow Way: How We Rank Ski Resorts by Snow | Snow Way") %>
<% content_for(:description, "Snow Way ranks #{@resort_count} North American ski resorts by forecast snowfall every 6 hours. Who built it, where the data comes from, and how rankings work.") %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
        { "@type" => "Organization", "@id" => "https://snowway.app/#organization", "name" => "Snow Way", "url" => "https://snowway.app", "logo" => "https://snowway.app/icon.png",
          "description" => "Free ski resort snow reports and forecasts that rank North American resorts by how much snow is coming.",
          "founder" => { "@id" => "https://justinmckelvey.com/#person" } },
        { "@type" => "Person", "@id" => "https://justinmckelvey.com/#person", "name" => "Justin McKelvey", "url" => "https://justinmckelvey.com",
          "image" => image_url("justin-roof-rail.webp"), "description" => "Former snowboard and bike shop owner turned software builder; creator of Snow Way.",
          "sameAs" => [ "https://www.linkedin.com/in/justinmckelvey", "https://x.com/justinmckelvey" ] },
        { "@type" => "AboutPage", "url" => absolute_url("/about"), "about" => { "@id" => "https://snowway.app/#organization" } },
        breadcrumb_schema([ [ "About", nil ] ]) ] }) %>
<% end %>
<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <%= render "shared/breadcrumbs", crumbs: [ [ "About", nil ] ] %>
    <article class="guide">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-6">About Snow Way</h1>
      <div class="tldr"><p>Snow Way answers one question: <strong>which ski resort is getting the most snow?</strong> It ranks <%= @resort_count %> North American resorts by forecast snowfall, updated every 6 hours, and it's free.</p></div>
      <h2>Who builds it</h2>
      <figure class="my-6 grid sm:grid-cols-2 gap-4 items-center">
        <%= image_tag "justin-roof-rail.webp", alt: "Justin McKelvey snowboarding a rail along the roof of a log cabin", width: 612, height: 612, loading: "lazy", class: "rounded-xl w-full h-auto" %>
        <%= image_tag "justin-chairlift-storm.webp", alt: "Justin McKelvey grinning on a chairlift in a snowstorm", width: 960, height: 720, loading: "lazy", class: "rounded-xl w-full h-auto" %>
      </figure>
      <p>Snow Way is built by <%= link_to "Justin McKelvey", author_path, rel: "author" %>. He lived in Vail, has ridden across North and South America, and ran snowboard and bike shops before teaching himself to code, and went on to ship more than 50 software products. He built Snow Way because finding the deep days shouldn't take ten browser tabs. <%= link_to "Read Justin's full bio", author_path %>.</p>
      <h2>From the slopes</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 my-6">
        <%= image_tag "photos/powder-jump-800.webp", alt: "Justin snowboarding off a powder jump in the trees", width: 800, height: 419, loading: "lazy", class: "rounded-lg w-full h-40 object-cover" %>
        <%= image_tag "photos/sitting-view-800.webp", alt: "Justin sitting on his snowboard above a valley of snowy ridges", width: 800, height: 533, loading: "lazy", class: "rounded-lg w-full h-40 object-cover" %>
        <%= image_tag "photos/canyon-selfie-800.webp", alt: "Justin smiling in a snowy mountain canyon", width: 800, height: 600, loading: "lazy", class: "rounded-lg w-full h-40 object-cover" %>
        <%= image_tag "photos/mammoth-road.webp", alt: "A road lined with tall snowbanks leading toward the mountains at sunset", width: 1200, height: 900, loading: "lazy", class: "rounded-lg w-full h-40 object-cover" %>
        <%= image_tag "photos/green-pants-view.webp", alt: "Snowboard boots and green pants resting in the snow with a wide mountain view", width: 640, height: 640, loading: "lazy", class: "rounded-lg w-full h-40 object-cover" %>
        <%= image_tag "photos/sunny-selfie.webp", alt: "Justin smiling in the sun among snowy pine trees", width: 676, height: 900, loading: "lazy", class: "rounded-lg w-full h-40 object-cover" %>
      </div>

      <h2>Where the data comes from</h2>
      <ul>
        <li><strong>Forecasts:</strong> <a href="https://open-meteo.com">Open-Meteo</a>, which blends national weather models. Snow Way requests each resort's forecast at its summit elevation, not the nearest town.</li>
        <li><strong>Seasonal patterns:</strong> 10 seasons of Open-Meteo historical weather data. Because weather models undercount mountain snowfall, Snow Way shows the monthly pattern, not inch totals.</li>
        <li><strong>Pass and opening facts:</strong> official Epic, Ikon, Mountain Collective, and Indy pass lists and resort announcements, each with a source and a check date.</li>
      </ul>
      <h2>How rankings work</h2>
      <p>Resorts are ranked by total forecast snowfall over the next 7 days, the range where forecasts are most useful. Days 8–14 are shown separately and labeled low-confidence. Snow Way doesn't accept payment for rankings.</p>
      <h2>Corrections and contact</h2>
      <p>Spot something wrong, or want your resort added? Reach out through <a href="https://justinmckelvey.com">justinmckelvey.com</a>.</p>
      <p>See also: <%= link_to "affiliate disclosure", affiliate_disclosure_path %> · <%= link_to "free snow forecast widget", widget_path %></p>
    </article>
  </main>
</div>
