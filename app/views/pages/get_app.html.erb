<% faqs = [
     { question: "Is there a Snow Way app?",
       answer: "Yes. Snow Way installs straight from your browser, with no app store needed. On iPhone, open snowway.app in Safari, tap Share, then Add to Home Screen. On Android, open it in Chrome and tap Install app. It's free." },
     { question: "Is the Snow Way app free?",
       answer: "Yes. The app and every forecast, ranking and guide on Snow Way are free. There's no account to make." },
     { question: "What's different about the app?",
       answer: "It opens full screen from your home screen, straight to the powder rankings, without browser bars. Long-press the icon on Android for shortcuts to where it's snowing, the rankings and the powder report. If you lose signal on the mountain, it shows a no-signal page instead of a browser error." },
     { question: "Does it update automatically?",
       answer: "Yes. The app always loads the latest forecasts and pages from snowway.app, so there's nothing to update." }
   ] %>
<% content_for(:title, "Get the Snow Way App: Free Ski Snow Forecasts on Your Phone") %>
<% content_for(:description, "Put Snow Way on your home screen: free powder rankings and 7-day snow forecasts for 180+ ski resorts, full screen, no app store needed. Install in two taps.") %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
        { "@type" => "WebApplication", "name" => "Snow Way", "url" => "https://snowway.app/", "applicationCategory" => "WeatherApplication",
          "operatingSystem" => "iOS, Android, Windows, macOS", "browserRequirements" => "Requires a modern web browser",
          "description" => "Ski resorts ranked by the next 7 days of snow, with forecasts and snow reports for 180+ resorts.",
          "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" }, "publisher" => { "@id" => "https://snowway.app/#organization" } },
        breadcrumb_schema([ [ "Get the app", nil ] ]),
        faq_schema(faqs)
      ] }) %>
<% end %>

<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-3xl mx-auto px-4 sm:px-6 py-8" data-controller="install" data-install-placement-value="app_page">
    <div class="flex items-center gap-4 mb-6">
      <img src="/icons/icon-192.png" alt="" width="72" height="72" class="w-[72px] h-[72px] rounded-2xl shrink-0">
      <div>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">Get the Snow Way app</h1>
        <p class="text-slate-400">Free. No app store, no account.</p>
      </div>
    </div>

    <p class="text-lg text-slate-200 mb-6">Snow Way ranks 180+ ski resorts by the next 7 days of snow. Put it on your home screen and it opens like any other app: full screen, one tap, straight to where the powder is.</p>

    <div class="mb-8">
      <a href="#install-steps" data-install-target="button" data-action="install#install" class="hidden bg-cyan-400 hover:bg-cyan-300 text-slate-900 font-bold text-lg rounded-xl px-6 py-3 transition">Install Snow Way</a>
    </div>

    <section id="install-steps" class="scroll-mt-20 mb-10">
      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-5">
          <h2 class="text-xl font-bold mb-3">iPhone and iPad</h2>
          <ol class="list-decimal pl-5 space-y-2 text-slate-300">
            <li>Open <strong class="text-white">snowway.app</strong> in <strong class="text-white">Safari</strong>.</li>
            <li>Tap the <strong class="text-white">Share</strong> button <span aria-hidden="true">(the square with an arrow)</span>.</li>
            <li>Scroll down and tap <strong class="text-white">Add to Home Screen</strong>, then <strong class="text-white">Add</strong>.</li>
          </ol>
          <p class="text-slate-400 text-sm mt-3">On recent iOS versions, Chrome and other browsers have Add to Home Screen in their Share menu too.</p>
        </div>
        <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-5">
          <h2 class="text-xl font-bold mb-3">Android</h2>
          <ol class="list-decimal pl-5 space-y-2 text-slate-300">
            <li>Open <strong class="text-white">snowway.app</strong> in <strong class="text-white">Chrome</strong>.</li>
            <li>Tap <strong class="text-white">Install app</strong> when it pops up, or open the <strong class="text-white">⋮ menu</strong>.</li>
            <li>Tap <strong class="text-white">Install app</strong> (or Add to Home screen), then <strong class="text-white">Install</strong>.</li>
          </ol>
          <p class="text-slate-400 text-sm mt-3">On a computer, Chrome and Edge show an install icon at the right end of the address bar.</p>
        </div>
      </div>
    </section>

    <h2 class="text-xl font-bold mb-3">What you get</h2>
    <ul class="grid sm:grid-cols-2 gap-3 mb-10">
      <li class="bg-slate-800/40 border border-slate-700 rounded-xl p-4"><strong class="block text-white mb-1">Powder rankings in one tap</strong><span class="text-slate-300 text-sm">Every resort ranked by the next 7 days of snow, updated through the day.</span></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-xl p-4"><strong class="block text-white mb-1">Full screen</strong><span class="text-slate-300 text-sm">No browser bars, more room for forecasts and snow tables.</span></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-xl p-4"><strong class="block text-white mb-1">Shortcuts</strong><span class="text-slate-300 text-sm">On Android, long-press the icon for where it's snowing, the rankings or the powder report.</span></li>
      <li class="bg-slate-800/40 border border-slate-700 rounded-xl p-4"><strong class="block text-white mb-1">Always current</strong><span class="text-slate-300 text-sm">Nothing to update. It loads the latest forecasts every time you open it.</span></li>
    </ul>

    <%= render "shared/inline_signup", magnet: "powder-calendar", id: "app-page" %>

    <%= render "shared/faq", faqs: faqs, heading: "Snow Way app questions" %>

    <p class="text-slate-300 mb-10">Start with <%= link_to "where it's snowing right now", where_is_it_snowing_path, class: "text-cyan-300 underline underline-offset-2" %> or the <%= link_to "powder rankings", resorts_path, class: "text-cyan-300 underline underline-offset-2" %>.</p>
  </main>
</div>
