<% share = (@resort.monthly_snow_share || {}).transform_keys(&:to_i) %>
<% months = (1..12).map { |m| [ m, share[m].to_f ] } %>
<% top3 = @resort.snowiest_months(3) %>
<% month_name = ->(m) { Date::MONTHNAMES[m] } %>
<% rotation = @resort.southern_hemisphere? ? 0 : 6 %>
<% season = months.rotate(rotation).select { |m, v| v >= 5 && @resort.ski_season_months.include?(m) }.map(&:first) %>
<% early = @resort.early_season_month %>
<% dec_share = months.find { |m, _| m == early }[1] %>
<% faqs = [] %>
<% if top3.any? %>
  <% faqs << { question: "What is the best time to ski #{@resort.name}?", answer: "For the best snow, ski #{@resort.name} in #{top3.map { |m, _| month_name.(m) }.to_sentence}. Those months bring #{top3.sum { |_, v| v }.round}% of a typical season's snowfall at the summit, based on 10 seasons of modeled weather data (2015–2025)." } %>
  <% faqs << { question: "What is the snowiest month at #{@resort.name}?", answer: "#{month_name.(top3.first[0])} is typically the snowiest month at #{@resort.name}, with about #{top3.first[1].round}% of the season's snow." } %>
  <% faqs << { question: "Does #{@resort.name} have good snow in #{month_name.(early)}?", answer: "#{month_name.(early)} brings about #{dec_share.round}% of #{@resort.name}'s typical seasonal snowfall#{top3.map(&:first).include?(early) ? ", making it one of the snowiest months" : (dec_share >= 10 ? ", a solid month though not the peak" : ", so early-season coverage can be thin")}. Check the live forecast before booking." } %>
<% end %>
<% odds = PowderOdds.for(@resort) %>
<% if odds&.values&.any?(&:positive?) %>
  <% best_m, best_v = odds.max_by { |_, v| v } %>
  <% faqs << { question: "What month has the most powder days at #{@resort.name}?", answer: "#{month_name.(best_m)}. In a typical #{month_name.(best_m)}, #{@resort.name} gets 1 inch or more of fresh snow on about #{best_v}% of days (roughly #{(best_v * Time.days_in_month(best_m, 2026) / 100.0).round} days), based on 10 seasons of modeled weather data at mid-mountain." } %>
<% end %>
<% faqs << { question: "Is #{@resort.name} getting snow right now?", answer: @summary.answer } %>

<% content_for(:title, fit_title("Best Time to Ski #{@resort.name}: Snowiest Months | Snow Way", "Best Time to Ski #{@resort.name} | Snow Way")) %>
<% content_for(:description, (faqs.first[:answer]).truncate(158)) %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
        { "@type" => "Article", "headline" => "Best Time to Ski #{@resort.name}", "url" => absolute_url("/resorts/#{@resort.slug}/best-time-to-ski"),
          "author" => author_schema, "dateModified" => Date.current.iso8601,
          "about" => { "@type" => "SkiResort", "name" => @resort.name } },
        breadcrumb_schema([ [ "Ski Resorts by State", "/ski-resorts" ], [ @resort.region_name, "/ski-resorts/#{@resort.region_slug}" ], [ @resort.name, "/resorts/#{@resort.slug}" ], [ "Best Time to Ski", nil ] ]),
        faq_schema(faqs)
      ] }) %>
<% end %>

<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <%= render "shared/breadcrumbs", crumbs: [ [ @resort.region_name, region_path(@resort.region_slug) ], [ @resort.name, resort_path(@resort) ], [ "Best Time to Ski", nil ] ] %>
    <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Best time to ski <%= @resort.name %></h1>
    <section class="mb-8 bg-slate-800/40 border border-slate-700 rounded-xl p-5">
      <p class="text-slate-200 leading-relaxed"><%= faqs.first[:answer] %></p>
    </section>

    <% if top3.any? %>
      <h2 class="text-xl font-bold mb-2"><%= @resort.name %> snowfall by month</h2>
      <p class="text-slate-400 text-sm mb-4">Share of a typical season's summit snowfall in each month.</p>
      <div class="border border-slate-700 rounded-xl p-4 mb-3" role="img" aria-label="<%= @resort.name %> share of seasonal snowfall by month: <%= months.select { |_, v| v >= 1 }.map { |m, v| "#{month_name.(m)} #{v.round}%" }.join(", ") %>">
        <div class="flex items-end gap-1 sm:gap-2 h-44">
          <% max = months.map(&:last).max.to_f.nonzero? || 1 %>
          <% months.rotate(rotation).each do |m, v| %>
            <div class="flex-1 flex flex-col items-center justify-end h-full">
              <span class="text-[10px] sm:text-xs text-slate-300 mb-1"><%= v >= 1 ? "#{v.round}%" : "" %></span>
              <div class="w-full rounded-t <%= top3.map(&:first).include?(m) ? "bg-cyan-400" : "bg-slate-600" %>" style="height: <%= (v / max * 100).round %>%"></div>
              <span class="text-[10px] sm:text-xs text-slate-400 mt-1"><%= Date::ABBR_MONTHNAMES[m] %></span>
            </div>
          <% end %>
        </div>
      </div>
      <p class="text-slate-400 text-xs mb-10">
        Source: Open-Meteo historical weather (ERA5-based reanalysis), July 2015 to June 2025, at <%= number_with_delimiter(@resort.elevation_summit) %> ft.
        Weather models undercount total mountain snowfall, so this shows the seasonal pattern, not inch totals. For season totals, see <%= link_to "#{@resort.name}'s website", @resort.website_url, rel: "noopener", target: "_blank", class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %>.
      </p>

      <% if odds&.values&.any?(&:positive?) %>
        <h2 class="text-xl font-bold mb-2">Chance of a fresh-snow day at <%= @resort.name %></h2>
        <p class="text-slate-400 text-sm mb-4">Share of days with 1"+ of new snow, by month. Higher means more powder mornings.</p>
        <div class="overflow-x-auto border border-slate-700 rounded-xl mb-3">
          <table class="w-full text-sm">
            <caption class="sr-only"><%= @resort.name %> chance of a fresh-snow day by month</caption>
            <thead class="bg-slate-800/70 text-slate-300"><tr><th scope="col" class="px-3 py-2 text-left">Month</th><th scope="col" class="px-3 py-2 text-left">Fresh-snow days</th><th scope="col" class="px-3 py-2 text-left">About</th></tr></thead>
            <tbody class="divide-y divide-slate-800">
              <% odds.each do |m, v| %>
                <tr class="<%= "bg-cyan-500/10" if m == odds.max_by { |_, x| x }.first %>"><th scope="row" class="px-3 py-2 text-left font-semibold"><%= month_name.(m) %></th><td class="px-3 py-2"><span class="inline-block align-middle h-2 rounded bg-cyan-400 mr-2" style="width: <%= [ v * 2, 2 ].max %>px"></span><%= v %>%</td><td class="px-3 py-2 text-slate-300"><%= (v * Time.days_in_month(m, 2026) / 100.0).round %> days</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="text-slate-400 text-xs mb-3">Source: <%= PowderOdds.source %>. Models undercount mountain snow, so real powder days are likely more frequent; use this to compare months and resorts.</p>
        <p class="text-sm text-slate-300 mb-10">Compare every resort by month: <%= safe_join(SkiMonth.all.map { |x| link_to(x.name, ski_month_path(x), class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200") }, " · ") %></p>
      <% end %>

      <h2 class="text-xl font-bold mb-3">How to time your trip</h2>
      <ul class="list-disc pl-5 space-y-2 text-slate-300 mb-10">
        <li><strong class="text-white">Deepest snow:</strong> <%= top3.map { |m, _| month_name.(m) }.to_sentence %> get the most snowfall, which usually means the best coverage and the most powder days.</li>
        <li><strong class="text-white">Main season:</strong> months that bring at least 5% of the season's snow are <%= season.map { |m| Date::ABBR_MONTHNAMES[m] }.join(", ") %>. Actual opening and closing dates are set by the resort.</li>
        <li><strong class="text-white">Book on the forecast:</strong> history tells you which months are reliable; the <%= link_to "7-day forecast", resort_path(@resort), class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %> tells you which week. Snow Way ranks every resort on it daily.</li>
      </ul>
    <% end %>

    <%= render "shared/trip_deals", resort: @resort, heading: "Found your month? Plan a trip to #{@resort.name}", css: "mb-10" %>
    <%= render "shared/calendar_cta" %>
    <% peers = @resort.region_peers.order(:name).limit(10) %>
    <% if peers.any? %>
      <h2 class="text-xl font-bold mb-3">Best time to ski other <%= @resort.region_name %> resorts</h2>
      <ul class="flex flex-wrap gap-2 mb-10 text-sm">
        <% peers.each do |r| %><li><%= link_to r.name, best_time_resort_path(r), class: "inline-block bg-slate-800 hover:bg-slate-700 rounded-lg px-3 py-2" %></li><% end %>
      </ul>
    <% end %>

    <%= render "shared/faq", faqs: faqs, heading: "#{@resort.name} season FAQ" %>
    <%= render "shared/cite_this", title: "Best Time to Ski #{@resort.name}", url: "https://snowway.app/resorts/#{@resort.slug}/best-time-to-ski" %>
    <p class="text-sm text-slate-400"><%= link_to "#{@resort.name} snow forecast", resort_path(@resort), class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %> · <%= link_to "Ski resorts in #{@resort.state_province}", region_path(@resort.region_slug), class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %></p>
  </main>
</div>
