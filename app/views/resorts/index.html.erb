<% content_for(:title, "Ski Resort Snow Forecast Rankings: Most Snow This Week | Snow Way") %>
<% content_for(:description, "#{Resort.count} North American ski resorts ranked by forecast snowfall for the next 7 days, updated every 6 hours. Find where the powder is before you book.") %>

<div class="min-h-screen">
  <%= render "shared/header" %>

  <main id="main" class="max-w-4xl mx-auto px-6 py-8">
    <!-- Title -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold mb-2">Ski Resort Powder Rankings</h1>
      <p class="text-slate-400">North American ski resorts ranked by forecast snowfall over the next 7 days. See also <%= link_to "where it's snowing this week", where_is_it_snowing_path, class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %> and <%= link_to "resorts by state", regions_path, class: "text-cyan-300 underline underline-offset-2 hover:text-cyan-200" %>.</p>
    </div>

    <% top_totals = Resort.projected_totals.sort_by { |_, v| -v }.first(3) %>
    <% top_resorts = Resort.where(id: top_totals.map(&:first)).index_by(&:id) %>
    <% if top_totals.any? && top_totals.first.last > 0 %>
      <section class="mb-6 bg-slate-800/40 border border-slate-700 rounded-xl p-5">
        <p class="text-slate-200 leading-relaxed">As of <%= Date.current.strftime("%B %-d, %Y") %>, <%= top_resorts[top_totals.first.first].name %> has the most snow forecast of the <%= Resort.count %> resorts Snow Way tracks: <%= inches(top_totals.first.last) %> at mid-mountain over the next 7 days<% if top_totals.size > 1 %>, followed by <%= top_totals.drop(1).map { |id, v| "#{top_resorts[id].name} (#{inches(v)})" }.to_sentence %><% end %>.</p>
      </section>
    <% end %>

    <!-- Sort Controls -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
      <%= link_to "Most Snow", resorts_path, class: "px-4 py-2 rounded-lg text-sm font-medium transition whitespace-nowrap #{params[:sort].nil? ? 'bg-cyan-500 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}" %>
      <%= link_to "Recent", resorts_path(sort: "recent"), class: "px-4 py-2 rounded-lg text-sm font-medium transition whitespace-nowrap #{params[:sort] == 'recent' ? 'bg-amber-500 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}" %>
      <%= link_to "A-Z", resorts_path(sort: "name"), class: "px-4 py-2 rounded-lg text-sm font-medium transition whitespace-nowrap #{params[:sort] == 'name' ? 'bg-cyan-500 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}" %>
      <%= link_to "By State", resorts_path(sort: "state"), class: "px-4 py-2 rounded-lg text-sm font-medium transition whitespace-nowrap #{params[:sort] == 'state' ? 'bg-cyan-500 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'}" %>
    </div>

    <!-- Resort List -->
    <div class="space-y-3">
      <% @resorts.each_with_index do |resort, index| %>
        <%= link_to resort_path(resort.slug), class: "block bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700 hover:border-slate-600 rounded-xl p-4 transition" do %>
          <div class="flex items-center gap-4">
            <!-- Rank -->
            <% if params[:sort].nil? %>
              <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg <%= index < 3 ? 'bg-cyan-500 text-slate-900' : 'bg-slate-700 text-slate-300' %>">
                <%= index + 1 %>
              </div>
            <% end %>

            <!-- Resort Info -->
            <div class="flex-1">
              <h2 class="font-bold text-lg"><%= resort.name %></h2>
              <p class="text-slate-400 text-sm"><%= resort.state_province %>, <%= resort.country %></p>
            </div>

            <!-- Snow Amount -->
            <div class="text-right">
              <% if resort.recent_snowfall_48h > 0 %>
                <p class="text-sm font-bold text-amber-400"><%= resort.recent_snowfall_48h %>" <span class="text-slate-400 font-normal">48h</span></p>
              <% end %>
              <p class="text-2xl font-bold text-cyan-400"><%= resort.projected_snowfall_7_day %>"</p>
              <p class="text-slate-400 text-xs">7-day forecast</p>
            </div>

            <!-- Arrow -->
            <div class="text-slate-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
