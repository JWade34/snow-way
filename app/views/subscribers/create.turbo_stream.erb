<%= turbo_stream.update(@magnet ? "#{@magnet}-form" : "alert-form") do %>
  <% if @saved && @magnet %>
    <% label = LeadMagnetsController::MAGNETS[@magnet][:label] %>
    <p class="text-lg font-bold mb-2">Your <%= label %> is ready ❄️</p>
    <%= link_to "Download the #{label} (PDF)", @magnet == "powder-calendar" ? powder_calendar_download_path(@subscriber.token) : lead_magnet_download_path(@magnet, @subscriber.token), class: "inline-block bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold rounded-lg px-5 py-3 transition", data: { turbo: false } %>
    <p class="text-slate-300 text-sm mt-3">You're also on the powder alert list for big storms. Unsubscribe anytime.</p>
  <% elsif @saved %>
    <p class="text-lg font-bold mb-1">You're on the list ❄️</p>
    <p class="text-slate-300 text-sm">We'll email <%= @subscriber.email %> when <%= @subscriber.resort ? "#{@subscriber.resort.name} is forecast #{@subscriber.threshold_inches}\"+" : "a big storm lines up" %>.</p>
  <% else %>
    <p class="text-lg font-bold mb-1">That email didn't work</p>
    <p class="text-slate-300 text-sm"><%= @subscriber.errors.full_messages.to_sentence %>. <%= link_to "Try again", request.referer || root_path, class: "underline" %></p>
  <% end %>
<% end %>
