<% year = Date.current.month >= 7 ? "#{Date.current.year}-#{(Date.current.year + 1) % 100}" : "#{Date.current.year - 1}-#{Date.current.year % 100}" %>
<% answer = "The best winter vacations in the US for snow: #{@items.first(5).map { |i| "#{i["name"]} (#{i["best_for"]})" }.to_sentence}." %>
<% faqs = [ { question: "What are the best winter vacations in the US?", answer: answer } ] %>
<% @items.first(5).each do |i| %><% faqs << { question: "Why visit #{i["name"].sub(/ in winter\z/i, "")} in winter?", answer: "#{i["why"]}#{i["when"].present? ? " Best time: #{i["when"].to_s.sub(/\.\z/, "")}." : ""}" } %><% end %>
<% content_for(:title, fit_title("Best Winter Vacations in the US (#{year}): #{@items.size} Snowy Trips | Snow Way", "Best Winter Vacations in the US (#{year}) | Snow Way")) %>
<% content_for(:description, "#{answer} What to do, when to go and where to stay for each.".truncate(300)) %>
<% content_for(:head) do %>
  <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
        { "@type" => "Article", "headline" => "Best winter vacations in the US", "url" => absolute_url(winter_vacations_path), "author" => author_schema,
          "publisher" => { "@id" => "https://snowway.app/#organization" }, "dateModified" => Date.current.iso8601,
          "speakable" => { "@type" => "SpeakableSpecification", "cssSelector" => [ "h1", ".tldr" ] } },
        breadcrumb_schema([ [ "Best Winter Vacations in the US", nil ] ]),
        { "@type" => "ItemList", "numberOfItems" => @items.size, "itemListElement" => @items.each_with_index.map { |i, n| { "@type" => "ListItem", "position" => n + 1, "name" => i["name"] } } },
        faq_schema(faqs)
      ] }) %>
<% end %>
<div class="min-h-screen">
  <%= render "shared/header" %>
  <main id="main" class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <%= render "shared/breadcrumbs", crumbs: [ [ "Best Winter Vacations in the US", nil ] ] %>
    <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Best winter vacations in the US (<%= year %>)</h1>
    <section class="tldr mb-8 bg-slate-800/40 border border-slate-700 rounded-xl p-5">
      <p class="text-slate-200 leading-relaxed"><%= answer %></p>
    </section>
    <p class="text-slate-400 text-xs -mt-6 mb-8">For a snowy winter trip: ski towns, national parks and mountain villages. Live snow for nearby resorts updated <%= updated_label(@updated_at) %>.</p>
    <ol class="space-y-6 mb-10">
      <% @items.each_with_index do |i, n| %>
        <% resort = Array(i["resorts"]).filter_map { |s| @resorts[s] }.first %>
        <li id="<%= i["slug"] %>" class="bg-slate-800/40 border border-slate-700 rounded-xl p-5 scroll-mt-20">
          <h2 class="text-xl font-bold"><span class="text-cyan-300 mr-1"><%= n + 1 %>.</span> <%= i["name"] %> <span class="text-slate-400 text-base font-normal"><%= i["state"] %></span></h2>
          <p class="text-cyan-300 text-sm font-semibold mb-2">Best for <%= i["best_for"] %></p>
          <p class="text-slate-300 mb-3"><%= i["why"] %></p>
          <% if Array(i["do"]).any? %>
            <ul class="text-sm text-slate-300 space-y-1 mb-3"><% i["do"].each do |d| %><% k, v = d.to_s.split(":", 2) %><li>• <% if v %><strong class="text-white"><%= k %>:</strong><%= v %><% else %><%= d %><% end %></li><% end %></ul>
          <% end %>
          <dl class="grid sm:grid-cols-3 gap-2 text-xs text-slate-400">
            <% if i["when"].present? %><div><dt class="font-semibold text-slate-300">When to go</dt><dd><%= i["when"] %></dd></div><% end %>
            <% if i["getting_there"].present? %><div><dt class="font-semibold text-slate-300">Getting there</dt><dd><%= i["getting_there"] %></dd></div><% end %>
            <% if resort %><div><dt class="font-semibold text-slate-300">Snow next 7 days</dt><dd><span class="text-cyan-300 font-bold"><%= inches(@totals.fetch(resort.id, 0.0)) %></span> at <%= resort.name %></dd></div><% end %>
          </dl>
          <% if (town = WinterTown.all.find { |t| (t.resorts.map(&:slug) & Array(i["resorts"])).any? }) %><p class="text-sm mt-2"><%= link_to "Things to do in #{town.name} in winter →", winter_town_path(town), class: "text-cyan-300 underline underline-offset-2" %></p><% end %>
          <%= render "travel_lists/stay", place: i["stay_place"].presence || i["name"], resort: resort %>
        </li>
      <% end %>
    </ol>
    <%= affiliate_disclosure("Hotel and rental links may earn Snow Way a commission.", css: "mb-8") %>
    <%= render "shared/calendar_cta" %>
    <%= render "shared/faq", faqs: faqs, heading: "Winter vacation questions" %>
    <p class="text-sm text-slate-300 mb-6">More: <%= link_to "Best ski towns", ski_towns_path, class: "text-cyan-300 underline underline-offset-2" %> · <%= link_to "Best places to ski in #{SkiMonth.current.name}", ski_month_path(SkiMonth.current), class: "text-cyan-300 underline underline-offset-2" %> · <%= link_to "Getting to the resorts", trip_routes_path, class: "text-cyan-300 underline underline-offset-2" %></p>
    <%= render "travel_lists/sources", items: @items %>
  </main>
</div>
