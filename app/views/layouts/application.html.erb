<!DOCTYPE html>
<html lang="en">
  <head>
    <% seo = SeoOverride.for_path(request.path) %>
    <% page_title = seo&.title.presence || content_for(:title) || "Snow Way - Chase the Powder" %>
    <% meta_description = (seo&.description.presence || content_for(:description).presence || "Find the ski resort getting the most snow in the next 7 days. Chase the powder with one tap.").to_s.squish.truncate(158, separator: " ") %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f172a">
    <%# Impact (REI affiliate) site verification. Impact issues a new code on each page load, so all recent codes stay. %>
    <% %w[5438474f-fedf-4118-8d5a-51388f06c2b2 d97cec98-9dc8-49e5-8c44-6947ed38c0d9 29169bbd-38ff-4f6f-a0e9-1806846e4776 3c8b0825-423b-4ea8-bda5-42fd62a7fdb0 40dd39db-0918-4813-8855-0aceae2dea1a].each do |code| %>
    <meta name="impact-site-verification" value="<%= code %>">
    <% end %>
    <meta name="description" content="<%= meta_description %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="canonical" href="<%= request.original_url.split('?').first %>" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="<%= content_for(:og_type) || "website" %>" />
    <%= yield :og_extra %>
    <meta property="og:url" content="<%= request.original_url %>" />
    <meta property="og:title" content="<%= page_title %>" />
    <meta property="og:description" content="<%= meta_description %>" />
    <meta property="og:image" content="<%= content_for(:og_image) || "https://snowway.app/preview.png" %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="<%= request.original_url %>" />
    <meta name="twitter:title" content="<%= page_title %>" />
    <meta name="twitter:description" content="<%= meta_description %>" />
    <meta name="twitter:image" content="<%= content_for(:og_image) || "https://snowway.app/preview.png" %>" />

    <!-- JSON-LD: site entity graph (same @ids everywhere, so every page links to one brand and one author) -->
    <%= json_ld({ "@context" => "https://schema.org", "@graph" => [
          { "@type" => "WebSite", "@id" => "https://snowway.app/#website", "name" => "Snow Way", "url" => "https://snowway.app",
            "alternateName" => [ "SnowWay", "snowway.app", "Snow Way ski snow forecasts" ],
            "description" => "Find the ski resort getting the most snow in the next 7 days. Chase the powder with one tap.",
            "publisher" => { "@id" => "https://snowway.app/#organization" }, "inLanguage" => "en-US",
            "potentialAction" => { "@type" => "SearchAction", "target" => "https://snowway.app/resorts?sort=name&q={search_term_string}", "query-input" => "required name=search_term_string" } },
          { "@type" => "Organization", "@id" => "https://snowway.app/#organization", "name" => "Snow Way", "url" => "https://snowway.app",
            "logo" => { "@type" => "ImageObject", "url" => "https://snowway.app/icon.png" },
            "sameAs" => [ "https://www.wikidata.org/wiki/Q142069934", "https://www.instagram.com/snowway.app/" ],
            "founder" => { "@id" => "https://justinmckelvey.com/#person" } },
          { "@type" => "Person", "@id" => "https://justinmckelvey.com/#person", "name" => "Justin McKelvey", "url" => "https://snowway.app/authors/justin-mckelvey",
            "sameAs" => [ "https://justinmckelvey.com", "https://www.linkedin.com/in/justinmckelvey", "https://x.com/justinmckelvey", "https://instagram.com/justinmckelvey", "https://youtube.com/@justinmckelvey" ],
            "knowsAbout" => [ "Skiing", "Snowboarding", "Ski resorts", "Snow forecasting", "Ski trip planning" ] }
        ] }) %>
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="alternate" type="text/plain" href="https://snowway.app/llms.txt" title="LLM-friendly site index" />
    <link rel="alternate" type="text/plain" href="https://snowway.app/llms-full.txt" title="LLM-friendly full data" />
    <link rel="alternate" type="application/atom+xml" href="https://snowway.app/feed.xml" title="Snow Way powder reports and guides" />

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preload" href="<%= asset_path("plus-jakarta-sans-latin.woff2") %>" as="font" type="font/woff2" crossorigin>

    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      // Load analytics after the page has rendered so it never competes with first paint.
      // Calls made before then are queued by the stub above.
      (function () {
        var start = function () {
          posthog.init('phc_cxKYFUzslK5k1Ie8ULHQQSjS4SqFxKz20vfsXJmGpyn', {
            api_host: 'https://us.i.posthog.com',
            defaults: '2026-01-30'
          })
        }
        // Stay22 Let Me Allez (Lift/Spark/Nova) turns booking links into affiliate links. It costs ~2s of CPU,
        // so it loads on the visitor's first interaction (booking buttons are below the fold), never on page load.
        // Let Me Allez also hijacks taps on links (even our own menu links) and redirects them through its
        // affiliate proxy. Catch taps on Snow Way links first, at the window in the capture phase, so its
        // handlers never see them. The browser (or Turbo) then navigates normally. Outbound links are untouched.
        ;['click', 'auxclick', 'mousedown', 'pointerdown', 'touchstart', 'touchend', 'pointerup', 'mouseup'].forEach(function (evt) {
          window.addEventListener(evt, function (e) {
            var a = e.target && e.target.closest && e.target.closest('a[href]')
            if (!a || a.closest('[data-booking]')) return
            var href = a.getAttribute('href') || ''
            if (href.charAt(0) === '/' || href.charAt(0) === '#' || a.origin === location.origin) e.stopImmediatePropagation()
          }, true)
        })
        var stay22Loaded = false
        var stay22 = function () {
          if (stay22Loaded) return
          stay22Loaded = true
          // Let Me Allez's auto-linking rewrites place names, including our own internal links ("Winter Park
          // snow forecast"), into hotel links. Keep internal navigation internal: undo any rewrite of a link
          // that pointed at Snow Way. Outbound booking links (Kayak, Booking.com) still convert.
          new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
              // Auto-inserted links around plain place names ("Spark") go back to plain text.
              m.addedNodes && m.addedNodes.forEach(function (n) {
                if (n.tagName === 'A' && /stay22\.com\/allez\/roam/.test(n.href) && !n.closest('[data-booking]')) {
                  n.replaceWith(document.createTextNode(n.textContent))
                }
              })
              if (m.type !== 'attributes') return
              var old = m.oldValue || ''
              if (m.target.tagName === 'A' && (old.charAt(0) === '/' || old.indexOf(location.origin) === 0) && m.target.getAttribute('href') !== old) {
                m.target.setAttribute('href', old)
              }
            })
          }).observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ['href'], attributeOldValue: true })
          window.Stay22 = window.Stay22 || {};
          window.Stay22.params = { lmaID: '6aed51010d63b07675116823' };
          var s = document.createElement('script'); s.async = true; s.src = 'https://lma.stay22.com/letmeallez.js';
          document.head.appendChild(s);
          // Third-party embeds (Stay22 lodging map) also wait for the first interaction.
          document.querySelectorAll('iframe[data-interaction-src]').forEach(function (f) { f.src = f.getAttribute('data-interaction-src') })
        }
        ;['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (evt) {
          window.addEventListener(evt, stay22, { once: true, passive: true })
        })
        var whenIdle = function () { 'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 3000 }) : setTimeout(start, 1500) }
        document.readyState === 'complete' ? whenIdle() : window.addEventListener('load', whenIdle, { once: true })
      })()
    </script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-900 text-white min-h-screen font-sans" style="font-family: 'Plus Jakarta Sans', sans-serif;">
    <%= yield %>
    <%= render "shared/footer" %>
    <%= yield :trip_bar %>
    <%= render "shared/promo_bar", compact: content_for?(:trip_bar) unless content_for?(:hide_promo) %>
  </body>
</html>
